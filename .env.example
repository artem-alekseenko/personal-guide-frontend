# Host development: backend sibling Compose stack publishes port 3001.
PG_API_BASE_URL=http://localhost:3001
# Built Nitro servers read this runtime override.
NUXT_PG_API_BASE_URL=http://localhost:3001
DOCKER_PG_API_BASE_URL=http://host.docker.internal:3001

# Public browser configuration; use the same Firebase project as the backend.
VUEFIRE_API_KEY=
VUEFIRE_AUTH_DOMAIN=
VUEFIRE_PROJECT_ID=
VUEFIRE_STORAGE_BUCKET=
VUEFIRE_MESSAGING_SENDER_ID=
VUEFIRE_APP_ID=
NUXT_PUBLIC_MAPBOX_GL_ACCESS_TOKEN=
# Optional Firebase App Check site key.
RECAPTCHA_KEY=

# Text panel; also enable TEXT_EXPERIENCE_ENABLED on the backend.
NUXT_PUBLIC_TEXT_EXPERIENCE_ENABLED=true
# Also requires STORY_BUFFER_ENABLED on the contract-capable backend.
# Enabling features does not authorize audio/playback verification.
NUXT_PUBLIC_STORY_BUFFER_ENABLED=true

# Optional endpoint overrides; defaults match ../personal-guide.ai.
PG_API_GUIDES_URL=/guides/
PG_API_ROUTE_SUGGESTION_URL=/guides/route_suggestions/
PG_API_CREATE_ROUTE_URL=/tours/
PG_API_LIST_TOURS_URL=/tours/
PG_API_GET_ME=/users/me/
PG_API_UPDATE_ME=/users/me/
